{
  "name": "carrot-tickets-api",
  "version": "1.0.0",
  "description": "Carrot Tickets Event Management & Ticketing API Backend",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/app.ts",
    "seed:admin": "ts-node -r tsconfig-paths/register src/scripts/seedAdmin.ts",
    "seed:test": "ts-node -r tsconfig-paths/register src/scripts/seedTestData.ts",
    "seed:sales": "ts-node -r tsconfig-paths/register src/scripts/seedSalesData.ts",
    "backfill:communities": "ts-node -r tsconfig-paths/register src/scripts/backfillCommunities.ts",
    "backfill:social-actor-types": "ts-node -r tsconfig-paths/register src/scripts/backfillSocialActorTypes.ts",
    "backfill:operator-type": "ts-node -r tsconfig-paths/register src/scripts/backfillOperatorType.ts",
    "backfill:edit-brand-permission": "ts-node -r tsconfig-paths/register src/scripts/backfillEditBrandPermission.ts",
    "backfill:event-ticketing": "ts-node -r tsconfig-paths/register src/scripts/backfillEventTicketing.ts",
    "backfill:external-ticketing": "ts-node -r tsconfig-paths/register src/scripts/backfillExternalTicketing.ts",
    "backfill:event-category": "ts-node -r tsconfig-paths/register src/scripts/backfillEventCategory.ts",
    "backfill:update-hashtags": "ts-node -r tsconfig-paths/register src/scripts/backfillUpdateHashtags.ts",
    "backfill:event-tag-register": "ts-node -r tsconfig-paths/register src/scripts/backfillEventTagRegister.ts",
    "backfill:sale-refunds": "ts-node -r tsconfig-paths/register src/scripts/backfillSaleRefunds.ts",
    "backfill:menu-stock-permissions": "ts-node -r tsconfig-paths/register src/scripts/backfillMenuStockPermissions.ts",
    "migrate:review-indexes": "ts-node -r tsconfig-paths/register src/scripts/migrate-review-indexes.ts",
    "migrate:merchant-credentials": "ts-node -r tsconfig-paths/register src/scripts/migrate-merchant-credentials.ts",
    "cleanup:eventless-cashiers": "ts-node -r tsconfig-paths/register src/scripts/cleanup-eventless-cashiers.ts",
    "seed:service-categories": "ts-node -r tsconfig-paths/register src/scripts/seed-service-categories.ts",
    "deploy:realtime": "bash scripts/deploy-realtime.sh",
    "migrate:update-media-array": "ts-node -r tsconfig-paths/register scripts/migrate-update-media-array.ts",
    "test:models": "ts-node -r tsconfig-paths/register src/scripts/testModels.ts",
    "test:payment": "ts-node -r tsconfig-paths/register src/scripts/testPaymentService.ts",
    "test:endpoints": "ts-node -r tsconfig-paths/register src/scripts/testEndpoints.ts",
    "test:comprehensive": "ts-node -r tsconfig-paths/register src/scripts/comprehensiveTest.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "jest",
    "seed:dev": "ts-node -r tsconfig-paths/register src/scripts/seedDevEnvironment.ts",
    "seed:cashless": "ts-node -r tsconfig-paths/register src/scripts/seedCashlessDemo.ts",
    "seed:menu-demo": "ts-node -r tsconfig-paths/register src/scripts/seedMenuDemo.ts",
    "yoco:register-webhook": "ts-node -r tsconfig-paths/register src/scripts/yocoRegisterWebhook.ts",
    "migrate:wallet-indexes": "ts-node -r tsconfig-paths/register src/scripts/migrate-wallet-indexes.ts"
  },
  "keywords": [
    "api",
    "nodejs",
    "typescript",
    "express",
    "mongodb",
    "tickets",
    "events",
    "carrot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.927.0",
    "@aws-sdk/s3-request-presigner": "^3.927.0",
    "@sentry/node": "^10.22.0",
    "@sentry/profiling-node": "^10.22.0",
    "@socket.io/mongo-adapter": "^0.3.2",
    "@socket.io/mongo-emitter": "^0.1.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/joi": "^17.2.3",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.8.10",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "socket.io-client": "^4.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
